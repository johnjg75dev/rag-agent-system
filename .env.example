# RAG Agent System Environment Configuration

# Database Connections
POSTGRES_URL=postgresql://user:password@localhost:5432/ragdb
REDIS_URL=redis://localhost:6379/0

# Celery Workers
CELERY_WORKER_CONCURRENCY=1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Embedding Models (HuggingFace model IDs)
TEXT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
VISION_EMBED_MODEL=
MULTIMODAL_EMBED_MODEL=

# Query LLM (optional — OpenAI-compatible API)
QUERY_LLM_MODEL=
QUERY_LLM_BASE_URL=
QUERY_LLM_API_KEY=

# Rerank Model (optional — CrossEncoder)
RERANK_MODEL=

# API
ORIGINS=http://localhost:3000,http://localhost:8000
SECRET_KEY=your-secret-key-change-in-prod

# Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_TOP_K=5

# Paths
MODELS_DIR=./models
UPLOAD_DIR=./uploads
